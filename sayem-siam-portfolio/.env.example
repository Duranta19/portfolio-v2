# Canonical public URL of the site (used for SEO: sitemap, robots, OG tags,
# structured data). On Vercel this auto-detects the production domain, but set
# it explicitly once you have a custom domain. No trailing slash.
# e.g. https://sayemsiam.dev  or  https://your-site.vercel.app
NEXT_PUBLIC_SITE_URL=

# Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=

# Sender address. Use Resend's shared domain until you verify your own domain.
# e.g. "Portfolio Contact <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
